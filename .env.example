FLASK_ENV=development
SECRET_KEY=change-me
DATABASE_URL=sqlite:///phy_analyzer.db

# RapidAPI / API-Football
RAPIDAPI_KEY=
RAPIDAPI_HOST=api-football-v1.p.rapidapi.com
API_FOOTBALL_BASE=https://api-football-v1.p.rapidapi.com/v3

# Behavior
TIMEZONE=Africa/Lagos
CONFIDENCE_THRESHOLD=0.62
MAX_DAILY_PICKS=5
MAX_COMBINED_ODDS=5.0

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:3000

# Set to 1 in production to enable the background scheduler (Phase 5).
# Leave 0 during local dev so `flask run --debug` reloads don't fire cron jobs.
SCHEDULER_ENABLED=0
